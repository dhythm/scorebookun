      "checkConstraints": {
        "game_events_restore_index_matches_state": {
          "name": "game_events_restore_index_matches_state",
          "value": "(\"game_events\".\"state\" = 'deleted') = (\"game_events\".\"restore_index\" is not null)"
        },
        "game_events_batted_ball_is_complete": {
          "name": "game_events_batted_ball_is_complete",
          "value": "(\"game_events\".\"batted_ball_position\" is null) = (\"game_events\".\"batted_ball_type\" is null) and (\"game_events\".\"batted_ball_depth\" is null or \"game_events\".\"batted_ball_type\" is not null)"
        },
        "game_events_kind_has_required_columns": {
          "name": "game_events_kind_has_required_columns",
          "value": "case \"game_events\".\"kind\"\n        when 'atBat' then \"game_events\".\"batter_id\" is not null and \"game_events\".\"at_bat_result\" is not null\n        when 'baseRunning' then \"game_events\".\"base_running_type\" is not null\n        when 'substitution' then \"game_events\".\"substitution_side\" is not null and \"game_events\".\"in_player_id\" is not null and \"game_events\".\"out_player_id\" is not null and \"game_events\".\"substitution_role\" is not null\n        when 'positionChange' then \"game_events\".\"position_change_side\" is not null\n        when 'runnerPlacement' then true\n        when 'gameControl' then \"game_events\".\"control_action\" is not null\n        when 'note' then \"game_events\".\"note_text\" is not null\n      end"
        }
      },
