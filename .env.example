# Copy to .env. Values here are for the local Docker database only.

# postgres: Docker (local) | pglite: no Docker (agent sandboxes) | neon: deployed
DATABASE_DRIVER=postgres

# Used by compose.yaml
POSTGRES_USER=scorebookun
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=scorebookun
POSTGRES_PORT=5432

# Used by the postgres and neon drivers. Keep in sync with the values above.
DATABASE_URL=postgres://scorebookun:local-development-only@127.0.0.1:5432/scorebookun

# Used by the pglite driver. Leave empty for an in-memory database.
PGLITE_DATA_DIR=.pglite
